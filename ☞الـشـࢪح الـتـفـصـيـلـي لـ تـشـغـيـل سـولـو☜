الـخـطـوة الـثـانـيـة

💻 تـثـبـيـت الـبـوت عـلـى تـࢪمـكـس

افـتـح بـرنـامـج تـࢪمـكـس، ثـم انـسـخ و الـصـق الأوامـر الـتـالـيـة بـالـتـرتـيـب:

---

❶

termux-setup-storage

📌 هـذا الأمـر يـطـلـب مـنـك تـفـعـيـل إذن الـوصـول إلـى الـمـلـفـات،
افـتـح الـخـيـار الـذي يـظـهـر وقـم بـتـفـعـيـل الإذن.

---

❷

pkg update && pkg upgrade -y && pkg install yt-dlp ffmpeg nodejs-lts python git wget curl binutils build-essential vips libjpeg-turbo libpng libwebp -y

🔄 تـحـديـث حـزم الـبـرنـامـج.

---

❸

cp -r /sdcard/SOLO ~/

📂 نـسـخ مـلـف الـبـوت إلـى مـجـلـد Termux.

---

❹

cd SOLO

📁 الـدخـول إلـى مـجـلـد الـبـوت.

---

❺

npm install

📦 تـثـبـيـت مـكـتـبـات الـبـوت.

---

❻

node index.js

🚀 تـشـغـيـل الـبـوت.

---

🔑 مـلاحـظـة مـهـمـة:

لـتـتـم الأمـر، اكـتـب الأمـر ثـم اضـغـط عـلـى (السـهـم الـموجـود أسـفـل يـمـيـن الـكـيـبـورد).

🟢 عـنـدمـا تـظـهـر علامة $ فـي شـاشـة تـࢪمـكـس،
هـذا يـعـنـي أن الأمـر الـسـابـق قـد انـتـهـى (بـنـجـاح او بـفـشـل).

